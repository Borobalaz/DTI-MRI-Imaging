flowchart TD
    subgraph UI[Qt UI executable]
        Context[QOpenGLWidget context]
        Adapter[QTSceneInspector]
    end

    subgraph Engine[engine DLL]
        Facade[Engine::InitializeOpenGL]
        Scene[Scene]
        Input[InputState and camera movement]
        Snapshot[SceneSnapshot: typed render commands]
        Extraction[ExtractionRegistry]
        Builder[RenderFrameBuilder]
        Resources[Model, Volume and concrete geometry resources]
        Inspect[InspectProvider and InspectField]
    end

    subgraph Render[engine_render static lib - engine/render]
        Init[InitializeGraphicsApi]
        Frame[RenderFrame and RenderDataStore]
        Passes[Insertion-ordered render pass vector via RenderBackend]
        Renderer[Renderer / ForwardRenderer]
        GpuResources[Shader, Material, Texture, Geometry, InstanceBuffer]
    end

    Context --> Facade
    Facade --> Init
    Context --> Scene
    UI -. input events .-> Input
    Input --> Scene
    Scene --> Resources
    Resources --> GpuResources
    Scene --> Inspect
    Scene --> Snapshot
    Snapshot --> Builder
    Extraction --> Builder
    Builder --> Frame
    Passes --> Renderer
    Frame --> Renderer
    Renderer --> Context
    Inspect --> Adapter
    Adapter -. field edits .-> Inspect

    Passes --> GpuResources
    Assets[(engine/assets and engine/shaders)] --> Resources
    Assets --> GpuResources
